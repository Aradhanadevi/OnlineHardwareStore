
@{
    ViewBag.Title = "Products";
}
<h2>Products</h2>
<div class="container mt-4">
    <h2 class="text-center">Product Listings</h2>
    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    <img src="@Url.Content(product.ImageUrl)" class="card-img-top" alt="@product.Name">
                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text">Price: <strong>₹@product.Price</strong></p>
                        <p class="card-text">@product.Description</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <a href="@Url.Action("Details", "Home", new { id = product.Name })" class="btn btn-primary">View Details</a>
                            <button class="btn btn-outline-success">Add to Cart</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
