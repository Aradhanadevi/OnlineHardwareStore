
@{
    ViewBag.Title = "Details";
}

<div class="container">
    <h2>@Model.Name</h2>
    <div class="row">
        <div class="col-md-6">
            <img src="@Url.Content(Model.ImageUrl)" class="img-fluid" alt="@Model.Name" />
        </div>
        <div class="col-md-6">
            <h3>Price: ₹@Model.Price</h3>
            <p>@Model.Description</p>
            <button class="btn btn-success" onclick="location.href='@Url.Action("AddToCart", "Home", new { productName = Model.Name })'">Add to Cart</button>
        </div>
    </div>
</div>
